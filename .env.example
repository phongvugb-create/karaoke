# Khóa API YouTube Data v3 từ Google Cloud Console (Bắt buộc để tìm kiếm bài hát thật)
YOUTUBE_API_KEY=your_actual_youtube_api_key_here

# Cổng khởi chạy Server Backend (Mặc định 3001)
PORT=3001

# Môi trường chạy ứng dụng: development | production
NODE_ENV=production

# Danh sách tên miền được phép truy cập (CORS) trong môi trường Production
# Các domain phân cách nhau bằng dấu phẩy, KHÔNG có dấu gạch chéo ở cuối
# Ví dụ: https://karaoke.example.com,https://app.karaoke.vn
CORS_ORIGINS=https://karaoke.example.com

# URL máy chủ Socket.IO cho Frontend kết nối (Bỏ trống nếu frontend và backend chạy cùng domain/port)
# Ví dụ: https://karaoke.example.com
VITE_SERVER_URL=
